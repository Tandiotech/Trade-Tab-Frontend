# ============================================================
# ENVIRONMENT VARIABLES — copy to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# ─── API Endpoints ───────────────────────────────────────────
# Base URL of the TradeTab backend (no trailing slash)
VITE_SERVER_URL_TESTNET=https://api-dev.yourdomain.com
VITE_SERVER_URL_MAINNET=https://api.yourdomain.com

# ─── Other services (use https in production; no defaults are shipped) ─────
# FXE account sync service
VITE_FXE_BASE_URL=https://fxe.yourdomain.com
# cTrader OAuth exchange service
VITE_CTRADER_API_URL=https://ctrader.yourdomain.com
# University platform
VITE_UNIVERSITY_URL=https://university.yourdomain.com

# ─── Feature Flags ───────────────────────────────────────────
# '1' = test/dev mode (enables debug logging via safeConsoleLog)
# '0' = production (silent)
VITE_TEST_MODE=0

# '1' = show ads; '0' = hide ads
VITE_DISPLAY_ADS=0

# ─── Support ─────────────────────────────────────────────────
# E.164 phone number for WhatsApp support link
VITE_PHONE_SUPPORT=+10000000000

# ─── Logo / Branding ─────────────────────────────────────────
VITE_LOGO_DEV_PUBLIC_KEY=your_logo_dev_public_key
VITE_LOGO_DEV_BASE_URL=https://img.logo.dev

# ─── Google OAuth ─────────────────────────────────────────────
# Obtain at https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Zoho CRM OAuth secrets must never be set here: every VITE_ variable ships to
# the browser. Call the Zoho CRM API from the backend instead.

# ─── Zoho CRM — Web-to-Contact Form Tokens ───────────────────
# ⚠️  The old hardcoded form tokens have been REMOVED from source.
#     Generate new tokens in Zoho CRM → Setup → Web Forms.
VITE_ZOHO_FORM_TOKEN_1=replace_with_new_xnQsjsdp_token
VITE_ZOHO_FORM_TOKEN_2=replace_with_new_xmIwtLD_token
